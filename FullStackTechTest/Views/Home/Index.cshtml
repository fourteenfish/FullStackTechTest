@model FullStackTechTest.Models.Home.IndexViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <table class="table table-bordered table-hover">
        <thead>
        <tr>
            <th>Id</th>
            <th>First Name</th>
            <th>Last Name</th>
        </tr>
        </thead>

        <form method="post" enctype="multipart/form-data" action="/Home/Import">
            Select file to import: <input type="file" name="file" required />
            <br />
            <input type="submit" value="Import" />
        </form>


        <tbody>
        @foreach (var person in Model.PeopleList)
        {
            <tr class="clickable-row" data-href="@Url.Action("Details", new { id = person.Id})">
                <td>@person.Id</td>
                <td>@person.FirstName</td>
                <td>@person.LastName</td>
            </tr>
        }
        </tbody>
    </table>
</div>
       
