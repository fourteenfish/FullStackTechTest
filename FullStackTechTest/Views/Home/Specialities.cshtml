@model FullStackTechTest.Models.Home.SpecialitiesViewModel

@{
    ViewData["Title"] = "Specialities Editor";
}
<div class="container">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Speciality</th>     
                <th></th>
            </tr>
        </thead>
        <form method="post" enctype="multipart/form-data" action="/Home/AddSpeciality">
            Add new Speciality: <input type="text" name="specialityName" required />
            <br />
            <input type="submit" value="Add" />
        </form>

        <tbody>
            @if (Model.SpecialityList != null && Model.SpecialityList.Any())
            {
                foreach (var speciality in Model.SpecialityList)
                {
                    <tr >
                        <td>@speciality.Id</td>
                        <td>@speciality.SpecialityName</td>
                        <td>
                            <form method="post" action="/Home/RemoveSpeciality">
                                <input type="hidden" name="specialityId" value="@speciality.Id" />
                                <button type="submit" class="btn btn-primary">Remove Speciality</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

